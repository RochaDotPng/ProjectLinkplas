<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Redirect to www, excluding sitemap.xml and robots.txt -->
                <rule name="Redirect to www" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^www\.(.*)$" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/(sitemap\.xml|robots\.txt)$" negate="true" />
                    </conditions>
                    <action type="Redirect" url="http://www.{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- Addresses from before the 2026 rebrand. Keep in step with vercel.json and
                     LEGACY_ROUTES in src/content/routes.js. The old categories come before the
                     product rule, which would otherwise catch them. The catalogue and the product
                     pages keep their query (a brand filter, a chosen size). -->
                <rule name="Legacy About" stopProcessing="true">
                    <match url="^About/?$" />
                    <action type="Redirect" url="/empresa/sobre-nos" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Policy" stopProcessing="true">
                    <match url="^Policy/?$" />
                    <action type="Redirect" url="/empresa/qualidade" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Contacts" stopProcessing="true">
                    <match url="^Contacts/?$" />
                    <action type="Redirect" url="/contactos" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Products" stopProcessing="true">
                    <match url="^Products/?$" />
                    <action type="Redirect" url="/produtos" appendQueryString="true" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Take-Away" stopProcessing="true">
                    <match url="^Products/Take-Away/?$" />
                    <action type="Redirect" url="/produtos?marcas=tupperlink" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Farmaceutica" stopProcessing="true">
                    <match url="^Products/Farmaceutica/?$" />
                    <action type="Redirect" url="/produtos?marcas=pharmalink" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Industria" stopProcessing="true">
                    <match url="^Products/Industria/?$" />
                    <action type="Redirect" url="/produtos?marcas=factorylink" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy Servicos" stopProcessing="true">
                    <match url="^Products/Servicos/?$" />
                    <action type="Redirect" url="/produtos/soldadura-por-ultrassons" appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="Legacy product pages" stopProcessing="true">
                    <match url="^Products/([^/]+)/?$" />
                    <action type="Redirect" url="/produtos/{R:1}" appendQueryString="true" redirectType="Permanent" />
                </rule>

                <!-- Single Page Application Rewrite Rule, excluding sitemap.xml and robots.txt -->
                <rule name="ReactAppRouting" stopProcessing="true">
                    <match url="^(?!.*\.(css|js|html|png|jpg|jpeg|gif|svg|ico|xml|txt)$).*$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_URI}" pattern="^/(sitemap\.xml|robots\.txt)$" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/index.html" />
                </rule>
            </rules>
        </rewrite>

        <!-- Static Content Caching -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
    </system.webServer>
</configuration>
